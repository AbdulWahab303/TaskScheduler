<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#FFFFFF" />  <!-- white background -->

    <!-- Border -->
    <stroke
        android:width="2dp"
        android:color="#3F51B5" />  <!-- blue border -->

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Optional padding inside -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp" />

</shape>
